# TalentTrivo Environment Configuration
# Copy this file to .env for local development

# Base URL for frontend API calls.
# Leave empty for relative calls (e.g. /api/leads) on the same origin.
VITE_API_BASE_URL=

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local SQLite database file path (relative to project root)
DATABASE_FILE=database/talenttrivo.db
